{
  "name": "aval-tejarat-persian",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-fonts.mjs && next dev",
    "build": "node scripts/sync-fonts.mjs && npm run content:check && next build && npm run verify:export",
    "start": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "content:check": "node scripts/check-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "images:cache": "node scripts/cache-blog-images.mjs",
    "verify:export": "node scripts/verify-static-export.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "gray-matter": "^4.0.3",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "three": "^0.187.0",
    "three-globe": "^2.45.6"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "serve": "^14.2.4",
    "@types/three": "^0.187.0"
  },
  "engines": {
    "node": ">=22"
  }
}
